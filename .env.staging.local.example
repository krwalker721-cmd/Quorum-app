# Staging Supabase project. Copy to .env.staging.local (gitignored) and fill in.
# Never put production values here: scripts/db.sh refuses any setting that
# points at the project in .env.local.

NEXT_PUBLIC_SUPABASE_URL=https://<staging-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Dashboard → Connect → "Session pooler" connection string, with the database
# password filled in. Used only by scripts/db.sh to apply migrations and run
# the database tests.
STAGING_DB_URL=postgresql://postgres.<staging-ref>:<password>@<region>.pooler.supabase.com:5432/postgres
