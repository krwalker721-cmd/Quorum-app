{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "quorum-dev",
      "runtimeExecutable": "/bin/zsh",
      "runtimeArgs": [
        "-lc",
        "npm run dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "quorum-dev-staging",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/dev-staging.mjs"
      ],
      "port": 3100
    }
  ]
}