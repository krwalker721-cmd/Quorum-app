NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
ADMIN_CODE=set-a-strong-passphrase-here

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe (payments)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_MEMBER_PRICE_ID=price_...
STRIPE_PARTNER_PRICE_ID=price_...
STRIPE_MEMBER_ANNUAL_PRICE_ID=price_...
STRIPE_FOUNDING_PRICE_ID=price_...

# Email (Resend) — trial reminders, approval and "you're in" emails
RESEND_API_KEY=re_...

# Vercel cron auth — /api/cron/* checks "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=set-a-long-random-string

# Error monitoring (Sentry)
NEXT_PUBLIC_SENTRY_DSN=
